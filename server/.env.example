# ---- Database ----
# Local dev (via `npm run db:up` docker-compose Postgres on host port 5544):
DATABASE_URL="postgresql://divya:divya@127.0.0.1:5544/divya_seva?schema=public"

# ---- Auth ----
# Generate a long random secret, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="replace-with-a-64-plus-char-random-hex-string"

# ---- Bootstrap admin (seeded into the DB) ----
# NOTE: the old public password "guruji108" is compromised — pick a NEW strong one.
ADMIN_EMAIL="guruji@divya.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
# Emails that may never be registered by normal signup (comma-separated, lowercased).
RESERVED_ADMIN_EMAILS="admin@divya.com,guruji@divya.com"

# ---- CORS / cookies ----
# Exact frontend origin(s), comma-separated. No trailing slash.
FRONTEND_ORIGIN="http://localhost:5173"
# Leave EMPTY in dev. In prod set to ".yourdomain.com" so the cookie is shared
# between yourdomain.com and api.yourdomain.com.
COOKIE_DOMAIN=""

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty in dev to log notifications to the console instead of sending.
RESEND_API_KEY=""
NOTIFY_EMAIL="pandit@example.com"
MAIL_FROM="Divya Seva <onboarding@resend.dev>"

# ---- Server ----
PORT="4000"
NODE_ENV="development"
